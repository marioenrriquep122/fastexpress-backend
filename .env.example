# Copiar como .env y ajustar. El .env NO se sube a GitHub.
SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
LOG_LEVEL=INFO

# Base de datos local: sqlite (por defecto) o postgres
DB_ENGINE=sqlite
DB_NAME=db.sqlite3
# Solo si DB_ENGINE=postgres:
# DB_USER=postgres
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432
